# Application Server Port
PORT=5000

# Authentication & Cryptographic Salt (used for salt-hashing credentials)
AUTH_SALT=generate_a_random_32_character_salt
JWT_SECRET=generate_a_random_jwt_secret_here

# Master Recovery Credentials for Admin Emergency Access
MASTER_ADMIN_USERNAME=your_master_recovery_username
MASTER_ADMIN_PASSWORD=your_master_recovery_password

# Environment
NODE_ENV=development

# Frontend API Base URL
VITE_API_URL=http://localhost:5000

