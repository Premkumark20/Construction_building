{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node -e \"if (process.env.VERCEL_GIT_COMMIT_REF === 'gh-pages') process.exit(0); else process.exit(1);\"",
  "functions": {
    "api/index.js": {
      "includeFiles": "app/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api"
    },
    {
      "source": "/logo/:path*",
      "destination": "/api"
    },
    {
      "source": "/videos/:path*",
      "destination": "/api"
    },
    {
      "source": "/frames/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

